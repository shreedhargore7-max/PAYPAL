# PayPal sandbox credentials from developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret

# Optional: if blank, ResolveOS uses a deterministic fallback classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Change this before using any shared or deployed environment.
ADMIN_API_KEY=replace-with-a-long-random-local-dev-key
